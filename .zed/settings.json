{
  "languages": {
    "Python": {
      "language_servers": [
        "ruff",
        "ty",
        "basedpyright",
        "pylsp",
      ],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "ruff",
          // We don't want to use "ruff format" as it changes way to much,
          // also removing formatting deliberately added to improve
          // reabability.
          "arguments": ["check", "--fix", "--silent", "-"],
        },
      },
    },
  },
  "lsp": {
    "pylsp": {
      "settings": {
        "plugins": {
          // Disable all plugins, we already have ruff/ty/basedpyright
          // (pylsp is only used for mypy)
          "autopep8": {"enabled": false},
          "flake8": {"enabled": false},
          "jedi": {"enabled": false},
          "jedi_completion": {"enabled": false},
          "jedi_definition": {"enabled": false},
          "jedi_hover": {"enabled": false},
          "jedi_references": {"enabled": false},
          "jedi_signature_help": {"enabled": false},
          "jedi_symbols": {"enabled": false},
          "mccabe": {"enabled": false},
          "preload": {"enabled": false},
          "pycodestyle": {"enabled": false},
          "pydocstyle": {"enabled": false},
          "pyflakes": {"enabled": false},
          "pylint": {"enabled": false},
          "rope_autoimport": {"enabled": false},
          "rope_completion": {"enabled": false},
          "yapf": {"enabled": false},
          // Enable only mypy
          "pylsp_mypy": {"enabled": true, "live_mode": false},
        },
      },
    },
  },
}
